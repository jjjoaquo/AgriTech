
from pathlib import Path
import json
import time

import cv2
from ultralytics import YOLO


class DetectorPlagas:
    def __init__(self, modelo_path):
        ruta = Path(modelo_path)

        if not ruta.is_file():
            raise FileNotFoundError(
                f"No existe el modelo: {ruta}"
            )

        self.modelo = YOLO(str(ruta))

    def detectar(
        self,
        imagen_path,
        confianza=0.35,
        carpeta_salida="resultados"
    ):
        inicio = time.perf_counter()

        imagen_path = Path(imagen_path)

        if not imagen_path.is_file():
            raise FileNotFoundError(
                f"No existe la imagen: {imagen_path}"
            )

        if not 0 <= confianza <= 1:
            raise ValueError(
                "La confianza debe estar entre 0 y 1"
            )

        resultados = self.modelo.predict(
            source=str(imagen_path),
            conf=confianza,
            verbose=False
        )

        resultado = resultados[0]
        detecciones = []

        for caja in resultado.boxes:
            clase_id = int(caja.cls[0])
            nombre = resultado.names[clase_id]

            detecciones.append({
                "clase": nombre,
                "confianza": round(
                    float(caja.conf[0]), 4
                ),
                "coordenadas": [
                    round(float(v), 2)
                    for v in caja.xyxy[0].tolist()
                ]
            })

        tiempo_ms = round(
            (time.perf_counter() - inicio) * 1000,
            2
        )

        salida = Path(carpeta_salida)
        salida.mkdir(
            parents=True,
            exist_ok=True
        )

        nombre = imagen_path.stem
        imagen_resultado = salida / f"{nombre}_detectado.jpg"
        json_resultado = salida / f"{nombre}_detecciones.json"

        cv2.imwrite(
            str(imagen_resultado),
            resultado.plot()
        )

        respuesta = {
            "imagen": imagen_path.name,
            "cantidad_detecciones": len(detecciones),
            "tiempo_ms": tiempo_ms,
            "detecciones": detecciones
        }

        with open(
            json_resultado, "w", encoding="utf-8"
        ) as archivo:
            json.dump(
                respuesta,
                archivo,
                indent=4,
                ensure_ascii=False
            )

        return respuesta
